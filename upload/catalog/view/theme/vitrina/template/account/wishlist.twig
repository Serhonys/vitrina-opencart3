{{ header }}
<main id="account-wishlist" class="vt-page">
  <div class="vt-wrap">
    <nav class="vt-crumbs">
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </nav>
{% if success %}<div class="alert alert-success alert-dismissible">{{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    <div class="vt-layout">
      {{ column_left }}
      <div id="content" class="vt-main">{{ content_top }}
<header class="vt-head"><h1>{{ heading_title }}</h1></header>
        {% if products %}
        <div class="vt-lines">
          {% for product in products %}
          <article class="vt-line">
            {% if product.thumb %}<a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" /></a>{% endif %}
            <div><h2><a href="{{ product.href }}">{{ product.name }}</a></h2><p>{{ product.model }}</p><p>{{ product.stock }}</p></div>
            <p class="vt-line-price">{% if product.price %}{% if not product.special %}{{ product.price }}{% else %}<span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span>{% endif %}{% endif %}</p>
            <div class="vt-line-tools">
              <button type="button" onclick="cart.add('{{ product.product_id }}');">{{ button_cart }}</button>
              <a href="{{ product.remove }}">{{ button_remove }}</a>
            </div>
          </article>
          {% endfor %}
        </div>
        {% else %}<p class="vt-empty">{{ text_empty }}</p>{% endif %}
        <p class="vt-actions"><a class="vt-btn" href="{{ continue }}">{{ button_continue }}</a></p>
        {{ content_bottom }}</div>
      {{ column_right }}</div>
  </div>
</main>
{{ footer }}
