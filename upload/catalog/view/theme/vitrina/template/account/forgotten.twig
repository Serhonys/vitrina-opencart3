{{ header }}
<main id="account-forgotten" class="vt-page">
  <div class="vt-wrap">
    <nav class="vt-crumbs">
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </nav>

    <div class="vt-layout">
      {{ column_left }}
      <div id="content" class="vt-main">{{ content_top }}
<header class="vt-head"><h1>{{ heading_title }}</h1></header>
        <p>{{ text_email }}</p>
        <form action="{{ action }}" method="post" enctype="multipart/form-data" class="vt-form vt-form-narrow">
          <label class="vt-field" for="input-email">{{ entry_email }}<input type="text" name="email" value="{{ email }}" id="input-email" /></label>
          <p class="vt-actions"><a class="vt-btn vt-btn-ghost" href="{{ back }}">{{ button_back }}</a><input type="submit" value="{{ button_continue }}" class="vt-btn" /></p>
        </form>
        {{ content_bottom }}</div>
      {{ column_right }}</div>
  </div>
</main>
{{ footer }}
