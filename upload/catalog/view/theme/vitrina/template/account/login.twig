{{ header }}
<main id="account-login" class="vt-page">
  <div class="vt-wrap">
    <nav class="vt-crumbs">
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </nav>
{% if success %}<div class="alert alert-success alert-dismissible">{{ success }}</div>{% endif %}
    {% if error_warning %}<div class="alert alert-danger alert-dismissible">{{ error_warning }}</div>{% endif %}
    <div class="vt-layout">
      {{ column_left }}
      <div id="content" class="vt-main">{{ content_top }}
<div class="vt-split">
          <section class="vt-panel">
            <h1>{{ text_new_customer }}</h1>
            <p><strong>{{ text_register }}</strong></p>
            <p>{{ text_register_account }}</p>
            <a class="vt-btn" href="{{ register }}">{{ button_continue }}</a>
          </section>
          <section class="vt-panel">
            <h1>{{ text_returning_customer }}</h1>
            <p>{{ text_i_am_returning_customer }}</p>
            <form action="{{ action }}" method="post" enctype="multipart/form-data" class="vt-form">
              <label class="vt-field" for="input-email">{{ entry_email }}<input type="text" name="email" value="{{ email }}" id="input-email" /></label>
              <label class="vt-field" for="input-password">{{ entry_password }}<input type="password" name="password" value="{{ password }}" id="input-password" /></label>
              <a href="{{ forgotten }}">{{ text_forgotten }}</a>
              <input type="submit" value="{{ button_login }}" class="vt-btn" />
              {% if redirect %}<input type="hidden" name="redirect" value="{{ redirect }}" />{% endif %}
            </form>
          </section>
        </div>
        {{ content_bottom }}</div>
      {{ column_right }}</div>
  </div>
</main>
{{ footer }}
