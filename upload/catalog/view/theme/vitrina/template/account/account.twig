{{ header }}
<main id="account-account" class="vt-page">
  <div class="vt-wrap">
    <nav class="vt-crumbs">
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </nav>
{% if success %}<div class="alert alert-success alert-dismissible">{{ success }}</div>{% endif %}
    <div class="vt-layout">
      {{ column_left }}
      <div id="content" class="vt-main">{{ content_top }}
<header class="vt-head"><h1>{{ text_my_account }}</h1></header>
        <div class="vt-account-grid">
          <section><h2>{{ text_my_account }}</h2><ul>
            <li><a href="{{ edit }}">{{ text_edit }}</a></li>
            <li><a href="{{ password }}">{{ text_password }}</a></li>
            <li><a href="{{ address }}">{{ text_address }}</a></li>
            <li><a href="{{ wishlist }}">{{ text_wishlist }}</a></li>
          </ul></section>
          {% if credit_cards %}<section><h2>{{ text_credit_card }}</h2><ul>{% for credit_card in credit_cards %}<li><a href="{{ credit_card.href }}">{{ credit_card.name }}</a></li>{% endfor %}</ul></section>{% endif %}
          <section><h2>{{ text_my_orders }}</h2><ul>
            <li><a href="{{ order }}">{{ text_order }}</a></li>
            <li><a href="{{ download }}">{{ text_download }}</a></li>
            {% if reward %}<li><a href="{{ reward }}">{{ text_reward }}</a></li>{% endif %}
            <li><a href="{{ return }}">{{ text_return }}</a></li>
            <li><a href="{{ transaction }}">{{ text_transaction }}</a></li>
            <li><a href="{{ recurring }}">{{ text_recurring }}</a></li>
          </ul></section>
          <section><h2>{{ text_my_affiliate }}</h2><ul>
            {% if not tracking %}<li><a href="{{ affiliate }}">{{ text_affiliate_add }}</a></li>
            {% else %}<li><a href="{{ affiliate }}">{{ text_affiliate_edit }}</a></li><li><a href="{{ tracking }}">{{ text_tracking }}</a></li>{% endif %}
          </ul></section>
          <section><h2>{{ text_my_newsletter }}</h2><ul><li><a href="{{ newsletter }}">{{ text_newsletter }}</a></li></ul></section>
        </div>
        {{ content_bottom }}</div>
      {{ column_right }}</div>
  </div>
</main>
{{ footer }}
