{{ header }}
<main id="product-manufacturer" class="vt-page">
  <div class="vt-wrap">
    <nav class="vt-crumbs">
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </nav>

    <div class="vt-layout">
      {{ column_left }}
      <div id="content" class="vt-main">{{ content_top }}
<header class="vt-head"><h1>{{ heading_title }}</h1></header>
        {% if categories %}
        <nav class="vt-refine"><p class="vt-kicker">{{ text_index }}</p>
          <ul>{% for category in categories %}<li><a href="index.php?route=product/manufacturer#{{ category.name }}">{{ category.name }}</a></li>{% endfor %}</ul>
        </nav>
        {% for category in categories %}
        <section class="vt-brand-group" id="{{ category.name }}">
          <h2>{{ category.name }}</h2>
          {% if category.manufacturer %}
          <ul class="vt-brand-list">{% for manufacturer in category.manufacturer %}<li><a href="{{ manufacturer.href }}">{{ manufacturer.name }}</a></li>{% endfor %}</ul>
          {% endif %}
        </section>
        {% endfor %}
        {% else %}
        <p class="vt-empty">{{ text_empty }}</p>
        <p class="vt-actions"><a class="vt-btn" href="{{ continue }}">{{ button_continue }}</a></p>
        {% endif %}
        {{ content_bottom }}</div>
      {{ column_right }}</div>
  </div>
</main>
{{ footer }}
