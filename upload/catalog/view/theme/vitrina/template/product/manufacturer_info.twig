{{ header }}
<main id="product-manufacturer" class="vt-page">
  <div class="vt-wrap">
    <nav class="vt-crumbs">
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </nav>

    <div class="vt-layout">
      {{ column_left }}
      <div id="content" class="vt-main">{{ content_top }}
<header class="vt-head"><h1>{{ heading_title }}</h1></header>
        {% if products %}
        <div class="vt-toolbar">
          <div class="vt-views">
            <button type="button" id="list-view" title="{{ button_list }}"><i class="fa fa-th-list"></i></button>
            <button type="button" id="grid-view" title="{{ button_grid }}"><i class="fa fa-th"></i></button>
          </div>
          <a class="vt-compare-link" href="{{ compare }}" id="compare-total">{{ text_compare }}</a>
          <label class="vt-select"><span>{{ text_sort }}</span>
            <select id="input-sort" onchange="location = this.value;">
              {% for sorts in sorts %}
              {% if sorts.value == '%s-%s'|format(sort, order) %}
              <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
              {% else %}
              <option value="{{ sorts.href }}">{{ sorts.text }}</option>
              {% endif %}
              {% endfor %}
            </select>
          </label>
          <label class="vt-select"><span>{{ text_limit }}</span>
            <select id="input-limit" onchange="location = this.value;">
              {% for limits in limits %}
              {% if limits.value == limit %}
              <option value="{{ limits.href }}" selected="selected">{{ limits.text }}</option>
              {% else %}
              <option value="{{ limits.href }}">{{ limits.text }}</option>
              {% endif %}
              {% endfor %}
            </select>
          </label>
        </div>
        <div class="vt-products row">
          {% for product in products %}
          <div class="product-layout product-grid">
          <article class="vt-card product-thumb">
            <a class="vt-card-media image" href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" /></a>
            <div class="vt-card-copy caption">
              <h3><a href="{{ product.href }}">{{ product.name }}</a></h3>
              <p class="vt-card-lead">{{ product.description }}</p>
              {% if product.price %}
              <p class="price">{% if not product.special %}{{ product.price }}{% else %}<span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span>{% endif %}{% if product.tax %} <span class="price-tax">{{ text_tax }} {{ product.tax }}</span>{% endif %}</p>
              {% endif %}
              {% if product.rating %}
              <div class="rating">{% for i in 1..5 %}{% if product.rating < i %}<i class="fa fa-star-o"></i>{% else %}<i class="fa fa-star"></i>{% endif %}{% endfor %}</div>
              {% endif %}
            </div>
            <div class="button-group vt-card-actions">
              <button type="button" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');">{{ button_cart }}</button>
              <button type="button" title="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }}');"><i class="fa fa-heart"></i></button>
              <button type="button" title="{{ button_compare }}" onclick="compare.add('{{ product.product_id }}');"><i class="fa fa-exchange"></i></button>
            </div>
          </article>
          </div>
          {% endfor %}
        </div>
        <div class="vt-pager"><div>{{ pagination }}</div><p>{{ results }}</p></div>
        {% else %}
        <p class="vt-empty">{{ text_empty }}</p>
        <p class="vt-actions"><a class="vt-btn" href="{{ continue }}">{{ button_continue }}</a></p>
        {% endif %}
        {{ content_bottom }}</div>
      {{ column_right }}</div>
  </div>
</main>
{{ footer }}
