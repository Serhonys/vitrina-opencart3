<div class="vt-split">
  <section>
    <h2>{{ text_new_customer }}</h2>
    <p>{{ text_checkout }}</p>
    <label class="vt-check">{% if account == 'register' %}<input type="radio" name="account" value="register" checked="checked" />{% else %}<input type="radio" name="account" value="register" />{% endif %} {{ text_register }}</label>
    {% if checkout_guest %}<label class="vt-check">{% if account == 'guest' %}<input type="radio" name="account" value="guest" checked="checked" />{% else %}<input type="radio" name="account" value="guest" />{% endif %} {{ text_guest }}</label>{% endif %}
    <p>{{ text_register_account }}</p>
    <input type="button" value="{{ button_continue }}" id="button-account" data-loading-text="{{ text_loading }}" class="vt-btn" />
  </section>
  <section>
    <h2>{{ text_returning_customer }}</h2>
    <p>{{ text_i_am_returning_customer }}</p>
    <label class="vt-field" for="input-email">{{ entry_email }}<input type="text" name="email" value="" id="input-email" /></label>
    <label class="vt-field" for="input-password">{{ entry_password }}<input type="password" name="password" value="" id="input-password" /></label>
    <a href="{{ forgotten }}">{{ text_forgotten }}</a>
    <input type="button" value="{{ button_login }}" id="button-login" data-loading-text="{{ text_loading }}" class="vt-btn" />
  </section>
</div>
