{{ header }}
<main id="checkout-cart" class="vt-page">
  <div class="vt-wrap">
    <nav class="vt-crumbs">
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </nav>
{% if attention %}<div class="alert alert-info alert-dismissible">{{ attention }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    {% if success %}<div class="alert alert-success alert-dismissible">{{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    {% if error_warning %}<div class="alert alert-danger alert-dismissible">{{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    <div class="vt-layout">
      {{ column_left }}
      <div id="content" class="vt-main">{{ content_top }}
<header class="vt-head"><h1>{{ heading_title }}{% if weight %} <small>{{ weight }}</small>{% endif %}</h1></header>
        <form class="vt-cart" action="{{ action }}" method="post" enctype="multipart/form-data">
          {% for product in products %}
          <article class="vt-line">
            {% if product.thumb %}<a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" /></a>{% endif %}
            <div>
              <h2><a href="{{ product.href }}">{{ product.name }}</a>{% if not product.stock %} <span class="text-danger">***</span>{% endif %}</h2>
              <p class="vt-meta-line">{{ product.model }}</p>
              {% if product.option %}{% for option in product.option %}<p>{{ option.name }}: {{ option.value }}</p>{% endfor %}{% endif %}
              {% if product.reward %}<p>{{ product.reward }}</p>{% endif %}
              {% if product.recurring %}<p>{{ text_recurring_item }} {{ product.recurring }}</p>{% endif %}
            </div>
            <label class="vt-qty"><span>{{ column_quantity }}</span>
              <input type="text" name="quantity[{{ product.cart_id }}]" value="{{ product.quantity }}" />
            </label>
            <p class="vt-line-price"><span>{{ product.price }}</span><strong>{{ product.total }}</strong></p>
            <div class="vt-line-tools">
              <button type="submit" title="{{ button_update }}">{{ button_update }}</button>
              <button type="button" onclick="cart.remove('{{ product.cart_id }}');">{{ button_remove }}</button>
            </div>
          </article>
          {% endfor %}
          {% for voucher in vouchers %}
          <article class="vt-line">
            <div><h2>{{ voucher.description }}</h2></div>
            <p class="vt-line-price"><strong>{{ voucher.amount }}</strong></p>
            <button type="button" onclick="voucher.remove('{{ voucher.key }}');">{{ button_remove }}</button>
          </article>
          {% endfor %}
        </form>
        {% if modules %}
        <section class="vt-next"><h2>{{ text_next }}</h2><p>{{ text_next_choice }}</p><div class="panel-group" id="accordion">{% for module in modules %}{{ module }}{% endfor %}</div></section>
        {% endif %}
        <aside class="vt-summary">
          {% for total in totals %}<p><span>{{ total.title }}</span><strong>{{ total.text }}</strong></p>{% endfor %}
          <p class="vt-actions"><a class="vt-btn vt-btn-ghost" href="{{ continue }}">{{ button_shopping }}</a><a class="vt-btn" href="{{ checkout }}">{{ button_checkout }}</a></p>
        </aside>
        {{ content_bottom }}</div>
      {{ column_right }}</div>
  </div>
</main>
{{ footer }}
